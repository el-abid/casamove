<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ToBe" targetNamespace="http://casamove.ma/bpmn">
  <bpmn:collaboration id="Collab_ToBe">
    <bpmn:participant id="Pool_ToBe" name="Service client augmenté (TO-BE)" processRef="Process_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
    <bpmn:lane id="Lane_T_Usager" name="Usager">
      <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Ouvre</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Lit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Resolu</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Recoit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Traite</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_T_Site" name="Site CasaMove">
      <bpmn:flowNodeRef>T_Site</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_T_Sup" name="Superviseur LangGraph">
      <bpmn:flowNodeRef>T_Class</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Intent</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Arbitre</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Escalade</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_T_IA" name="Agents IA">
      <bpmn:flowNodeRef>T_Rag</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Pert</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_TicketP3</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_TicketCree</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Qualifie</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Sla</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Brouillon</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_T_Humain" name="Agent humain">
      <bpmn:flowNodeRef>T_Valide</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Decision</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>T_Envoie</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="T_Start" name="Besoin d'information ou de réclamation" />
    <bpmn:userTask id="T_Ouvre" name="Ouvre le chat de la page" />
    <bpmn:serviceTask id="T_Site" name="Affiche le widget et le flux" />
    <bpmn:serviceTask id="T_Class" name="Classifie l'intention" />
    <bpmn:exclusiveGateway id="T_Intent" name="Intention ?" />
    <bpmn:serviceTask id="T_Rag" name="Recherche RAG et cite les sources" />
    <bpmn:exclusiveGateway id="T_Pert" name="Pertinence suffisante ?" />
    <bpmn:userTask id="T_Lit" name="Lit la réponse et les sources" />
    <bpmn:endEvent id="T_Resolu" name="Résolu" />
    <bpmn:serviceTask id="T_TicketP3" name="Crée un ticket P3" />
    <bpmn:endEvent id="T_TicketCree" name="Ticket créé" />
    <bpmn:serviceTask id="T_Qualifie" name="Qualifie et crée le ticket" />
    <bpmn:serviceTask id="T_Sla" name="Calcule le SLA" />
    <bpmn:serviceTask id="T_Brouillon" name="Prépare le brouillon" />
    <bpmn:userTask id="T_Valide" name="Valide, édite ou rejette" />
    <bpmn:exclusiveGateway id="T_Decision" name="Décision ?" />
    <bpmn:serviceTask id="T_Envoie" name="Envoie et journalise" />
    <bpmn:userTask id="T_Recoit" name="Reçoit la réponse et le numéro" />
    <bpmn:endEvent id="T_Traite" name="Traité" />
    <bpmn:userTask id="T_Arbitre" name="Arbitre le cas" />
    <bpmn:endEvent id="T_Escalade" name="Escaladé" />
    <bpmn:sequenceFlow id="T_f1" sourceRef="T_Start" targetRef="T_Ouvre" />
    <bpmn:sequenceFlow id="T_f2" sourceRef="T_Ouvre" targetRef="T_Site" />
    <bpmn:sequenceFlow id="T_f3" sourceRef="T_Site" targetRef="T_Class" />
    <bpmn:sequenceFlow id="T_f4" sourceRef="T_Class" targetRef="T_Intent" />
    <bpmn:sequenceFlow id="T_f5" sourceRef="T_Intent" targetRef="T_Rag" name="Information" />
    <bpmn:sequenceFlow id="T_f6" sourceRef="T_Intent" targetRef="T_Qualifie" name="Réclamation" />
    <bpmn:sequenceFlow id="T_f7" sourceRef="T_Rag" targetRef="T_Pert" />
    <bpmn:sequenceFlow id="T_f8" sourceRef="T_Pert" targetRef="T_Lit" name="oui" />
    <bpmn:sequenceFlow id="T_f9" sourceRef="T_Pert" targetRef="T_TicketP3" name="non" />
    <bpmn:sequenceFlow id="T_f10" sourceRef="T_TicketP3" targetRef="T_TicketCree" />
    <bpmn:sequenceFlow id="T_f11" sourceRef="T_Qualifie" targetRef="T_Sla" />
    <bpmn:sequenceFlow id="T_f12" sourceRef="T_Sla" targetRef="T_Brouillon" />
    <bpmn:sequenceFlow id="T_f13" sourceRef="T_Brouillon" targetRef="T_Valide" />
    <bpmn:sequenceFlow id="T_f14" sourceRef="T_Valide" targetRef="T_Decision" />
    <bpmn:sequenceFlow id="T_f15" sourceRef="T_Decision" targetRef="T_Envoie" name="approuvé" />
    <bpmn:sequenceFlow id="T_f16" sourceRef="T_Decision" targetRef="T_Arbitre" name="rejeté" />
    <bpmn:sequenceFlow id="T_f17" sourceRef="T_Arbitre" targetRef="T_Escalade" />
    <bpmn:sequenceFlow id="T_f18" sourceRef="T_Envoie" targetRef="T_Recoit" />
    <bpmn:sequenceFlow id="T_f19" sourceRef="T_Recoit" targetRef="T_Traite" />
    <bpmn:sequenceFlow id="T_f20" sourceRef="T_Lit" targetRef="T_Resolu" />
    <bpmn:textAnnotation id="T_Ann1">
      <bpmn:text>Chaque étape écrit le journal d'audit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="T_Ann1_assoc" sourceRef="T_Ann1" targetRef="T_Class" />
    <bpmn:textAnnotation id="T_Ann2">
      <bpmn:text>Aucun envoi sans décision humaine</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="T_Ann2_assoc" sourceRef="T_Ann2" targetRef="T_Valide" />
  </bpmn:process>
