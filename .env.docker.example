# Copier vers .env.docker puis lancer :
# docker compose --env-file .env.docker up -d --build

APP_PORT=3000

CASAMOVE_DB_NAME=casamove
CASAMOVE_DB_USER=casamove
# Utiliser un mot de passe compatible URL ou l'encoder avant de le placer dans DATABASE_URL.
CASAMOVE_DB_PASSWORD=casamove

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

LLM_ENABLED=true
EMBEDDINGS_ENABLED=true
RENEWAL_AUTO=true
COOKIE_SECURE=false
