# Base Postgres locale du projet (cluster dédié, port 5544)
DATABASE_URL=postgresql://casamove@127.0.0.1:5544/casamove

# Agents et embeddings via NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# Interrupteurs utiles en test ou hors ligne
LLM_ENABLED=true
EMBEDDINGS_ENABLED=true

# Cookie de session en HTTPS uniquement (false en local)
COOKIE_SECURE=false

# Relance automatique des abonnements au démarrage puis toutes les 24 h
RENEWAL_AUTO=true
